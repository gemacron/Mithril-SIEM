# ==========================================
# MITHRIL SIEM - ENVIRONMENT CONFIGURATION
# ==========================================

# Core Django Settings
DEBUG=False
SECRET_KEY=replace_this_with_a_secure_random_key_in_production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Initial First-Run Root Credentials (Mandatory Change on First Login)
MITHRIL_INIT_ADMIN_USER=admin
MITHRIL_INIT_ADMIN_PASSWORD=MithrilSecurity2026!
MITHRIL_INIT_ADMIN_EMAIL=security@mithril.local

# PostgreSQL Database Configuration
DB_NAME=mithril_siem
DB_USER=mithril_user
DB_PASSWORD=mithril_secure_pg_pass_2026
DB_HOST=mithril-db
DB_PORT=5432

# Redis Cache / Message Broker (Celery & WebSockets)
REDIS_HOST=mithril-redis
REDIS_PORT=6379

# Security Thresholds & Autoban Engine
MITHRIL_BAN_CANDIDATE_THRESHOLD=80
MITHRIL_ANOMALY_WINDOW_SECONDS=600
MITHRIL_DEFAULT_BAN_HOURS=24

# Telegram Bot Alerts (Optional - can also be configured via Web UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=False
